APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev runs on SQLite: `touch database/database.sqlite`, then
# `php artisan migrate:fresh --seed`. Never point this at the production
# DB_HOST — the migrations in this repo are a local mirror and must not
# run against db2026.
DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/database/database.sqlite

# Read-only replica of production, for inspecting real data in tinker.
# Opt-in and never the default — every write path fails against it.
# DB_HOST_REPLICA=
# DB_PORT_REPLICA=3306
# DB_DATABASE_REPLICA=db2026
# DB_USERNAME_REPLICA=
# DB_PASSWORD_REPLICA=

PAYMENT_ALERT_DUE_SOON_DAYS=3
PAYMENT_ALERT_OVERDUE_GRACE_DAYS=3

# Defaults to Transbank's public integration/sandbox commerce code + API key
# when unset — see config/webpay.php. Set real values for production.
# Leave WEBPAY_COMMERCE_CODE / WEBPAY_API_KEY commented out (not blank —
# env() treats an empty value as set, which would send empty credentials).
#
# WEBPAY_ENVIRONMENT=production requires both to be real: App\Support\Webpay
# throws rather than pointing at the live host with sandbox keys. From that
# moment every click is a real charge.
WEBPAY_ENVIRONMENT=integration
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=

# Bank reconciliation. When true, importing a cartola records the payment
# for any deposit carrying the payer's RUT *and* the exact plan amount with
# no rival candidate — see config/bank_reconciliation.php. Those rows are
# irreversible from the UI, so this is the switch that turns the behaviour
# off and sends every deposit back to the staff review queue.
BANK_RECON_AUTO_CONFIRM=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Required over HTTPS. Set SESSION_SECURE_COOKIE=true in any deployed
# environment; leave it unset locally or the login session won't stick.
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
